# Copiá a infra/.env. Solo placeholders: nunca commitear valores reales.
# La service_role vive ÚNICAMENTE acá (worker/simulador), jamás en la app móvil.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplazar-por-tu-service-role-key
KAFKA_BROKERS=redpanda:9092
# Password que usará el script de aprovisionamiento para los usuarios de prueba
DEMO_PASSWORD=reemplazar-por-un-password-de-prueba
# IDs de estaciones (separados por coma) que el simulador deja de publicar para la demo stale
DISABLED_STATION_IDS=
